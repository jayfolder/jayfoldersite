---
import '../components/global.css';
import '../components/home.css';
---

<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>jayfolder</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script>
    import "../components/script.js";
  </script>
  </head>

  <body>  
  <div class="center fadeIn"> <!-- for centering -->
    <div class="content" style="width: 800px">
      <img src="ccc.svg"/>
      <div id="social" class="interactable_c">
          <img src="yt.svg" onclick="move_page('https://www.youtube.com/@jayfolder', 'blank')">
          <img src="x.svg" onclick="move_page('https://x.com/jayf0lder', 'blank')">
          <img src="itchio.svg" onclick="move_page('https://jayfolder.itch.io/', 'blank')">  
          <img src="gamejolt.svg" onclick="move_page('https://gamejolt.com/@jayfolder', 'blank')">   
        </div>
      <div class="about_textbox about_text" style="width: 1000px">
        <div style="width: 700px; font-size: 21px;">
            <b>my name is jay</b>, a black male taking part in creating multiple forms of media, but most notably game development! i assist with multiple projects, create 2D & 3D art/animation, graphic design and video edit!<br>feel free to <b>learn more about me</b> and <b>check out my portfolio</b>
          </div>
          <img src="boi.svg" style="height: 165px;padding-left: 20px">
      </div>

      <div id="home_nav">
        <button class="button interactable" onclick="move_page('about', 'self')">about me</button>
        <button class="button interactable" onclick="move_page('portfolio', 'self')">check out my portfolio!</button>
        </div>

    </div>
  </div>
</body>
</html>
