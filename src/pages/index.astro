---
import '../components/global.css';
import '../components/home.css';
import DarkMode from '../components/dark_mode.astro';
import TextBox from '../components/textbox.astro';
---

<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>jayfolder</title>
    <meta property="og:title" content="jayfolder's website">
    <meta property="og:description" content="i am jayfolder and this is my personal website. hello guys!">
    <meta property="og:image" content="/favicon.png">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script>
    import "../components/script.js";
  </script>
  </head>

  <body>  
    <div class="center fadeIn">
      <div class="content" style="width: 800px">
        <img src="ccc.svg" style="margin: 11px;"/>
        <div id="social" class="interactable_c" style="margin-bottom: 11px">
            <img src="yt.svg" onclick="move_page('https://www.youtube.com/@jayfolder', 'blank')">
            <img src="x.svg" onclick="move_page('https://x.com/jayf0lder', 'blank')">
            <img src="insta.svg" onclick="move_page('https://www.instagram.com/jayf0lder/', 'blank')">
            <img src="itchio.svg" onclick="move_page('https://jayfolder.itch.io/', 'blank')">  
            <img src="gamejolt.svg" onclick="move_page('https://gamejolt.com/@jayfolder', 'blank')">   
        </div>
        <TextBox title="information" image="boi.svg" text="<b>my name is jay</b>, a black male creating multiple forms of media, most notably game development! i work on multiple projects, create 2D & 3D art/animation, graphic design and video edit!<br><b>feel free to check out my portfolio!</b>"/>
        <button class="button interactable" onclick="move_page('portfolio', 'self')">check out my portfolio!</button>
      </div>
    </div>
    <DarkMode/>
  </body>
</html>
